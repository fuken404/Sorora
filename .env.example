# demo: el SOS es una simulación, no guarda nada ni avisa a nadie (valor por defecto).
# live: guarda la alerta y avisa por Telegram. Requiere ALERT_API_KEY y Telegram.
MODE=demo

# memory para desarrollo sin base de datos; mongo para MongoDB.
STORAGE=memory
MONGO_URI=
MONGO_DB=sorora

# Protege la creación, edición y borrado de albergues.
ADMIN_API_KEY=

# Solo para MODE=live.
ALERT_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
